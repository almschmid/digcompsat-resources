   <row>
    <id><![CDATA[117139]]></id>
    <qid><![CDATA[112267]]></qid>
    <question><![CDATA[Ich achte sorgfältig darauf, dass ich die Regeln für Urheberrechte und Lizenzen für digitale Inhalte, die ich finde, befolge.]]></question>
