   <row>
    <id><![CDATA[117164]]></id>
    <qid><![CDATA[112292]]></qid>
    <question><![CDATA[Ich weiss, welche persönlichen Daten ich nicht online weitergeben und anzeigen sollte (z. B. in sozialen Medien). ]]></question>
