    <language><![CDATA[de]]></language>
    <script/>
   </row>
   <row>
    <id><![CDATA[117142]]></id>
    <qid><![CDATA[112270]]></qid>
    <question><![CDATA[Ich weiss, welche verschiedenen Arten von Lizenzen für die Nutzung digitaler Inhalte gelten (z. B. Creative-Commons-Lizenzen). ]]></question>
