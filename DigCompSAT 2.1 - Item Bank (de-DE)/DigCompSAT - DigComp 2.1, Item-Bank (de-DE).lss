    <script/>
   </row>
   <row>
    <id><![CDATA[117166]]></id>
    <qid><![CDATA[112294]]></qid>
    <question><![CDATA[Ich bin mir bewusst, dass ich die Zeit, die ich mit meinen digitalen Geräten verbringe, einteilen sollte. ]]></question>
