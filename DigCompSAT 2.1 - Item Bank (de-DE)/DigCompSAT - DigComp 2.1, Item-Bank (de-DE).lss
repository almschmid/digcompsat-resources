   <row>
    <id><![CDATA[117095]]></id>
    <qid><![CDATA[112223]]></qid>
    <question><![CDATA[Ich weiss, dass verschiedene Suchmaschinen unterschiedliche Suchergebnisse liefern können, weil sie von kommerziellen Faktoren beeinflusst werden. ]]></question>
