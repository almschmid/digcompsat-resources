   <row>
    <id><![CDATA[117141]]></id>
    <qid><![CDATA[112269]]></qid>
    <question><![CDATA[Ich kann erkennen, wenn digitale Inhalte illegal zur Verfügung gestellt werden (z. B. Software, Filme, Musik, Bücher, Fernsehen). ]]></question>
